@version 1
@target java

braces {
    style = same_line
    force_single = true
}

spacing {
    before_brace = true
    after_comma = true
    around_binary = true
    after_keyword = true
}

indent {
    size = 4
    style = spaces
}

blank_lines {
    max_consecutive = 1
    between_methods = 1
    between_fields = 0
    after_imports = 1
    after_package = 1
}