# Request a personal API key at https://console.curseforge.com and paste it here.
# The launcher never sees this value; only the bridge talks to CurseForge.
CURSEFORGE_API_KEY=

# Interface the bridge listens on. Keep it on loopback unless you intentionally
# want other machines on your network to use this bridge.
HOST=127.0.0.1
PORT=8787

# Seconds a successful CurseForge response is reused for.
CACHE_TTL_SECONDS=300
